<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Online Library Management System</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <div class="logo">📚 Library Management System</div>

    <nav>
        <a href="#home">Home</a>
        <a href="#books">Books</a>
        <a href="#members">Members</a>
        <a href="#issue">Issue / Return</a>
    </nav>
</header>

<section id="home" class="hero">
    <div>
        <h1>Online Library Management System</h1>
        <p>Manage books, members and library transactions easily.</p>
        <a href="#books" class="btn">Explore Books</a>
    </div>
</section>

<section class="dashboard">

    <div class="card">
        <h3>Total Books</h3>
        <p id="totalBooks">0</p>
    </div>

    <div class="card">
        <h3>Available Books</h3>
        <p id="availableBooks">0</p>
    </div>

    <div class="card">
        <h3>Members</h3>
        <p id="totalMembers">0</p>
    </div>

    <div class="card">
        <h3>Issued Books</h3>
        <p id="issuedBooks">0</p>
    </div>

</section>

<!-- BOOKS -->

<section id="books" class="section">

    <h2>📚 Book Management</h2>

    <div class="form-container">

        <input type="text" id="bookTitle" placeholder="Book Title">
        <input type="text" id="bookAuthor" placeholder="Author">
        <input type="text" id="bookCategory" placeholder="Category">

        <button onclick="addBook()">Add Book</button>

    </div>

    <input
        type="text"
        id="searchBook"
        class="search"
        placeholder="Search books..."
        onkeyup="displayBooks()"
    >

    <div class="table-container">

        <table>

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody id="bookTable"></tbody>

        </table>

    </div>

</section>

<!-- MEMBERS -->

<section id="members" class="section">

    <h2>👥 Member Management</h2>

    <div class="form-container">

        <input type="text" id="memberName" placeholder="Member Name">
        <input type="email" id="memberEmail" placeholder="Email">
        <input type="text" id="memberPhone" placeholder="Phone">

        <button onclick="addMember()">Add Member</button>

    </div>

    <div class="table-container">

        <table>

            <thead>

                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Action</th>
                </tr>

            </thead>

            <tbody id="memberTable"></tbody>

        </table>

    </div>

</section>

<!-- ISSUE / RETURN -->

<section id="issue" class="section">

    <h2>📖 Issue / Return Books</h2>

    <div class="form-container">

        <select id="issueBook"></select>
        <select id="issueMember"></select>

        <button onclick="issueBook()">Issue Book</button>

    </div>

    <div class="table-container">

        <table>

            <thead>

                <tr>
                    <th>Book</th>
                    <th>Member</th>
                    <th>Issue Date</th>
                    <th>Action</th>
                </tr>

            </thead>

            <tbody id="issueTable"></tbody>

        </table>

    </div>

</section>

<footer>

    <p>© 2026 Online Library Management System</p>

</footer>

<script src="script.js"></script>

</body>
</html>

